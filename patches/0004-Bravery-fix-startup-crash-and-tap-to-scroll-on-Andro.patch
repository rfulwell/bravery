@@ -58,17 +58,33 @@ public final class BraveryController implements BraveContentView.BraveryHook {
 
     private final class TabState extends WebContentsObserver {
         final BraveryTapToScroll tapToScroll;
+        private boolean mAttached;
 
         TabState(WebContents webContents) {
             super(webContents);
             tapToScroll = new BraveryTapToScroll(webContents);
+            attachIfReady();
+        }
+
+        /**
+         * The view is created before its WebContents is initialized, and until then content's
+         * per-WebContents helpers are unavailable. Returns whether the helpers are attached.
+         */
+        boolean attachIfReady() {
+            if (mAttached) return true;
+            WebContents webContents = getWebContents();
+            if (webContents == null || webContents.isDestroyed()) return false;
             GestureListenerManager gestures = GestureListenerManager.fromWebContents(webContents);
-            if (gestures != null) gestures.addListener(tapToScroll);
+            if (gestures == null) return false;
+            gestures.addListener(tapToScroll);
             BraverySelectionMenuDelegate.ensureInstalled(webContents);
+            mAttached = true;
+            return true;
         }
 
         @Override
         public void primaryMainDocumentElementAvailable() {
+            attachIfReady();
             applyBannerRules();
         }
 
