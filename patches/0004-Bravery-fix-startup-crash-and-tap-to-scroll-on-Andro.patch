+  // Listeners added by page scripts aren't visible from this world, so a
+  // pointer cursor stands in for "has a click handler".
+  const INTERACTIVE_SELECTOR = [
+    'a[href]', 'button', 'input', 'select', 'textarea', 'label', 'summary',
+    'iframe', 'video[controls]', 'audio[controls]',
+    '[contenteditable]:not([contenteditable="false"])', '[onclick]',
+    '[tabindex]:not([tabindex="-1"])', '[role="button"]', '[role="link"]',
+    '[role="checkbox"]', '[role="radio"]', '[role="switch"]', '[role="tab"]',
+    '[role="menuitem"]', '[role="option"]', '[role="slider"]',
+    '[role="textbox"]',
+  ].join(',')
+
+  function isInteractive(el) {
+    if (!el) {
+      return true
+    }
+    return Boolean(el.closest(INTERACTIVE_SELECTOR))
+      || getComputedStyle(el).cursor === 'pointer'
+  }
