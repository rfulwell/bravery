 bool SkipGURLField(std::string_view value, GURL* field) {
   return true;
@@ -456,18 +522,29 @@ void AdBlockSubscriptionServiceManager::LoadSubscriptionServices() {
   }
 }
 
-// Bravery: adds the default lists once, so a list the user removes stays
-// removed.
+// Bravery: adds each default list once, so lists added to the array later
+// reach existing installs and a list the user removes stays removed.
 void AdBlockSubscriptionServiceManager::AddBraveryDefaultSubscriptions() {
   DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
 
-  if (!local_state_ ||
-      local_state_->GetBoolean(kBraveryDefaultSubscriptionsAdded)) {
+  if (!local_state_) {
     return;
   }
 
-  CreateSubscription(GURL(kBraveryEasyListUrl));
-  local_state_->SetBoolean(kBraveryDefaultSubscriptionsAdded, true);
+  base::ListValue added =
+      local_state_->GetList(kBraveryDefaultSubscriptionsAdded).Clone();
+  bool changed = false;
+  for (const char* url : kBraveryDefaultSubscriptionUrls) {
+    if (added.contains(url)) {
+      continue;
+    }
+    CreateSubscription(GURL(url));
+    added.Append(url);
+    changed = true;
+  }
+  if (changed) {
+    local_state_->SetList(kBraveryDefaultSubscriptionsAdded, std::move(added));
+  }
 }
 
 // Updates preferences to reflect a new state for the specified filter list
