@@ -0,0 +1,99 @@
+/* Copyright (c) 2026 The Bravery Authors. All rights reserved.
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+package org.chromium.chrome.browser.bravery;
+
+import android.content.Context;
+import android.content.pm.ResolveInfo;
+import android.view.View;
+
+import org.chromium.chrome.R;
+import org.chromium.content_public.browser.SelectionMenuItem;
+import org.chromium.content_public.browser.SelectionPopupController;
+import org.chromium.content_public.browser.WebContents;
+import org.chromium.content_public.browser.selection.SelectionActionMenuDelegate;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Adds "Hide banner" to the text selection menu, so long-pressing text inside a banner works too.
+ * Wraps, rather than replaces, any delegate Chrome already installed.
+ */
+final class BraverySelectionMenuDelegate implements SelectionActionMenuDelegate {
+    private final SelectionActionMenuDelegate mInner;
+
+    private BraverySelectionMenuDelegate(SelectionActionMenuDelegate inner) {
+        mInner = inner;
+    }
+
+    static void ensureInstalled(WebContents webContents) {
+        if (webContents == null || webContents.isDestroyed()) return;
+        SelectionPopupController controller = SelectionPopupController.fromWebContents(webContents);
+        if (controller == null) return;
+        SelectionActionMenuDelegate current = controller.getSelectionActionMenuDelegate();
+        if (current instanceof BraverySelectionMenuDelegate) return;
+        controller.setSelectionActionMenuDelegate(new BraverySelectionMenuDelegate(current));
+    }
+
+    @Override
+    public int[] getDefaultMenuItemOrder(int menuType) {
+        return mInner != null
+                ? mInner.getDefaultMenuItemOrder(menuType)
+                : SelectionActionMenuDelegate.getDefaultMenuItemOrder();
+    }
+
+    @Override
+    public List<SelectionMenuItem> getAdditionalMenuItems(
+            int menuType,
+            boolean isSelectionPassword,
+            boolean isSelectionReadOnly,
+            String selectedText) {
+        List<SelectionMenuItem> items = new ArrayList<>();
+        if (mInner != null) {
+            items.addAll(
+                    mInner.getAdditionalMenuItems(
+                            menuType, isSelectionPassword, isSelectionReadOnly, selectedText));
+        }
+        // Only page text, never editable fields.
+        if (isSelectionReadOnly && BraveryPrefs.isBannerMenuEnabled()) {
+            items.add(
+                    new SelectionMenuItem.Builder(R.string.bravery_banner_hide)
+                            .setId(R.id.bravery_banner_autohide)
+                            .setGroupId(R.id.select_action_menu_delegate_items)
+                            .setOrder(100)
+                            .build());
+        }
+        return items;
+    }
+
+    @Override
+    public List<ResolveInfo> filterTextProcessingActivities(
+            int menuType, List<ResolveInfo> activities) {
+        return mInner != null
+                ? mInner.filterTextProcessingActivities(menuType, activities)
+                : activities;
+    }
+
+    @Override
+    public boolean canReuseCachedSelectionMenu(int menuType) {
+        return mInner == null || mInner.canReuseCachedSelectionMenu(menuType);
+    }
+
+    @Override
+    public boolean handleMenuItemClick(
+            SelectionMenuItem item, WebContents webContents, View containerView) {
+        if (item.id == R.id.bravery_banner_autohide) {
+            BraveryBannerHider.hideSelection(webContents, BraveryBannerHider.MODE_AUTOHIDE);
+            return true;
+        }
+        return mInner != null && mInner.handleMenuItemClick(item, webContents, containerView);
+    }
+
+    @Override
+    public String getWebSearchMenuItemTitle(Context context, String selectedText) {
+        return mInner != null ? mInner.getWebSearchMenuItemTitle(context, selectedText) : null;
+    }
+}
diff --git a/android/java/org/chromium/chrome/browser/bravery/BraveryTapToScroll.java b/android/java/org/chromium/chrome/browser/bravery/BraveryTapToScroll.java
new file mode 100644
index 000000000..a8717295e
--- /dev/null
+++ b/android/java/org/chromium/chrome/browser/bravery/BraveryTapToScroll.java
@@ -0,0 +1,309 @@
+/* Copyright (c) 2026 The Bravery Authors. All rights reserved.
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+package org.chromium.chrome.browser.bravery;
+
+import android.os.SystemClock;
+import android.view.InputDevice;
+import android.view.MotionEvent;
+import android.view.ViewConfiguration;
+
+import org.chromium.components.embedder_support.view.BraveContentView;
+import org.chromium.content_public.browser.GestureStateListener;
+import org.chromium.content_public.browser.WebContents;
+
+import java.lang.ref.WeakReference;
+
+/**
+ * Native tap-to-scroll for one WebContents.
+ *
+ * <p>Taps are observed on the way into the page. Once the renderer has processed a tap, content
+ * reports back whether the page handled it (link, button, form field, or a page script that
+ * reacted). Only taps the page ignored, inside a scroll zone, turn into a scroll. The scroll is a
+ * short synthetic finger drag at the tap position, so it scrolls whatever is under the finger
+ * (including inner scrollers) and the toolbar hides and shows exactly as for a real swipe.
+ */
+final class BraveryTapToScroll extends GestureStateListener {
+    // A GestureTap is reported up to ~300ms late on pages that allow double-tap zoom.
+    private static final long MAX_TAP_ACK_DELAY_MS = 1500;
+    private static final long RELEASE_HOLD_MS = 80;
+
+    private static final float EDGE_ZONE = 0.15f;
+    private static final float SIDE_ZONE = 0.20f;
+    private static final float CORNER_ZONE_WIDTH = 0.30f;
+    private static final float CORNER_ZONE_HEIGHT = 0.15f;
+
+    private final WeakReference<WebContents> mWebContents;
+    private WeakReference<BraveContentView> mView = new WeakReference<>(null);
+
+    private int mTouchSlop = -1;
+    private boolean mTapCandidate;
+    private float mDownX;
+    private float mDownY;
+    private long mDownTime;
+
+    private float mTapX;
+    private float mTapY;
+    private long mTapTime = -1;
+
+    private boolean mInjecting;
+    private ScrollAnimation mAnimation;
+
+    BraveryTapToScroll(WebContents webContents) {
+        mWebContents = new WeakReference<>(webContents);
+    }
+
+    void setView(BraveContentView view) {
+        if (mView.get() != view) {
+            cancelAnimation();
+            mView = new WeakReference<>(view);
+        }
+    }
+
+    void onTouchEvent(BraveContentView view, MotionEvent event) {
+        if (mInjecting) return;
+        setView(view);
+        switch (event.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                // A real finger always wins over a scroll we are still animating.
+                cancelAnimation();
+                mTapCandidate =
+                        event.getPointerCount() == 1
+                                && event.getToolType(0) == MotionEvent.TOOL_TYPE_FINGER;
+                mDownX = event.getX();
+                mDownY = event.getY();
+                mDownTime = event.getEventTime();
+                break;
+            case MotionEvent.ACTION_POINTER_DOWN:
+            case MotionEvent.ACTION_CANCEL:
+                mTapCandidate = false;
+                break;
+            case MotionEvent.ACTION_MOVE:
+                if (mTapCandidate
+                        && Math.hypot(event.getX() - mDownX, event.getY() - mDownY)
+                                > getTouchSlop(view)) {
+                    mTapCandidate = false;
+                }
+                break;
+            case MotionEvent.ACTION_UP:
+                if (mTapCandidate
+                        && event.getEventTime() - mDownTime
+                                < ViewConfiguration.getLongPressTimeout()) {
+                    mTapX = event.getX();
+                    mTapY = event.getY();
+                    mTapTime = SystemClock.uptimeMillis();
+                }
+                mTapCandidate = false;
+                break;
+            default:
+                break;
+        }
+    }
+
+    @Override
+    public void onSingleTap(boolean consumed) {
+        long tapTime = mTapTime;
+        mTapTime = -1;
+        if (consumed || tapTime < 0) return;
+        if (SystemClock.uptimeMillis() - tapTime > MAX_TAP_ACK_DELAY_MS) return;
+        if (!BraveryPrefs.isTapScrollEnabled()) return;
+
+        WebContents webContents = mWebContents.get();
+        BraveContentView view = mView.get();
+        if (webContents == null || webContents.isDestroyed() || view == null) return;
+        if (BraveryPrefs.isTapScrollDisabledForSite(
+                webContents.getLastCommittedUrl().getHost())) {
+            return;
+        }
+
+        int direction =
+                zoneDirection(
+                        BraveryPrefs.getTapScrollLayout(),
+                        mTapX,
+                        mTapY,
+                        view.getWidth(),
+                        view.getHeight());
+        if (direction == 0) return;
+        if (BraveryPrefs.isTapScrollInverted()) direction = -direction;
+        startScroll(view, direction, mTapX, mTapY);
+    }
+
+    @Override
+    public void onDestroyed() {
+        cancelAnimation();
+    }
+
+    /** Returns 1 to scroll down (towards the end of the page), -1 to scroll up, 0 for no zone. */
+    static int zoneDirection(String layout, float x, float y, int width, int height) {
+        if (width <= 0 || height <= 0) return 0;
+        if (BraveryPrefs.LAYOUT_SIDES.equals(layout)) {
+            if (x < width * SIDE_ZONE) return -1;
+            if (x > width * (1 - SIDE_ZONE)) return 1;
+            return 0;
+        }
+        if (BraveryPrefs.LAYOUT_CORNERS.equals(layout)) {
+            boolean inCornerColumn =
+                    x < width * CORNER_ZONE_WIDTH || x > width * (1 - CORNER_ZONE_WIDTH);
+            if (!inCornerColumn) return 0;
+            if (y < height * CORNER_ZONE_HEIGHT) return -1;
+            if (y > height * (1 - CORNER_ZONE_HEIGHT)) return 1;
+            return 0;
+        }
+        if (y < height * EDGE_ZONE) return -1;
+        if (y > height * (1 - EDGE_ZONE)) return 1;
+        return 0;
+    }
+
+    private void startScroll(BraveContentView view, int direction, float tapX, float tapY) {
+        cancelAnimation();
+        int height = view.getHeight();
+        float margin = height * 0.04f;
+        float maxTravel = height - 2 * margin;
+        // Chromium swallows the first touch-slop of a drag before scrolling starts.
+        float travel =
+                Math.min(
+                        maxTravel,
+                        height * BraveryPrefs.getTapScrollDistance() + getTouchSlop(view));
+
+        // Scrolling down means the finger moves up the screen, and vice versa. Start at the tap
+        // so the drag targets whatever scroller is under it, shifted just enough to fit.
+        float startY = tapY;
+        float endY = startY - direction * travel;
+        if (endY < margin) {
+            startY += margin - endY;
+            endY = margin;
+        } else if (endY > height - margin) {
+            startY -= endY - (height - margin);
+            endY = height - margin;
+        }
+
+        mAnimation =
+                new ScrollAnimation(
+                        view, tapX, startY, endY, BraveryPrefs.getTapScrollDurationMs());
+        mAnimation.start();
+    }
+
+    private void cancelAnimation() {
+        if (mAnimation != null) {
+            mAnimation.cancel();
+            mAnimation = null;
+        }
+    }
+
+    private int getTouchSlop(BraveContentView view) {
+        if (mTouchSlop < 0) {
+            mTouchSlop = ViewConfiguration.get(view.getContext()).getScaledTouchSlop();
+        }
+        return mTouchSlop;
+    }
+
+    private boolean dispatch(
+            BraveContentView view, int action, float x, float y, long downTime, long eventTime) {
+        MotionEvent.PointerProperties properties = new MotionEvent.PointerProperties();
+        properties.id = 0;
+        properties.toolType = MotionEvent.TOOL_TYPE_FINGER;
+        MotionEvent.PointerCoords coords = new MotionEvent.PointerCoords();
+        coords.x = x;
+        coords.y = y;
+        coords.pressure = 1f;
+        coords.size = 1f;
+        MotionEvent event =
+                MotionEvent.obtain(
+                        downTime,
+                        eventTime,
+                        action,
+                        1,
+                        new MotionEvent.PointerProperties[] {properties},
+                        new MotionEvent.PointerCoords[] {coords},
+                        /* metaState= */ 0,
+                        /* buttonState= */ 0,
+                        /* xPrecision= */ 1f,
+                        /* yPrecision= */ 1f,
+                        /* deviceId= */ 0,
+                        /* edgeFlags= */ 0,
+                        InputDevice.SOURCE_TOUCHSCREEN,
+                        /* flags= */ 0);
+        mInjecting = true;
+        try {
+            return view.onTouchEvent(event);
+        } finally {
+            mInjecting = false;
+            event.recycle();
+        }
+    }
+
+    /** Drives a synthetic one-finger drag, one step per frame, with an eased velocity profile. */
+    private final class ScrollAnimation implements Runnable {
+        private final WeakReference<BraveContentView> mTarget;
+        private final float mX;
+        private final float mStartY;
+        private final float mEndY;
+        private final long mDurationMs;
+        private long mDownTime;
+        private float mLastY;
+        private boolean mActive;
+        private final Runnable mRelease = this::release;
+
+        ScrollAnimation(
+                BraveContentView view, float x, float startY, float endY, long durationMs) {
+            mTarget = new WeakReference<>(view);
+            mX = x;
+            mStartY = startY;
+            mEndY = endY;
+            mDurationMs = Math.max(1, durationMs);
+        }
+
+        void start() {
+            BraveContentView view = mTarget.get();
+            if (view == null) return;
+            mDownTime = SystemClock.uptimeMillis();
+            mLastY = mStartY;
+            mActive = true;
+            dispatch(view, MotionEvent.ACTION_DOWN, mX, mStartY, mDownTime, mDownTime);
+            view.postOnAnimation(this);
+        }
+
+        @Override
+        public void run() {
+            BraveContentView view = mTarget.get();
+            if (!mActive || view == null) return;
+            long now = SystemClock.uptimeMillis();
+            float t = Math.min(1f, (now - mDownTime) / (float) mDurationMs);
+            mLastY = mStartY + (mEndY - mStartY) * easeInOut(t);
+            dispatch(view, MotionEvent.ACTION_MOVE, mX, mLastY, mDownTime, now);
+            if (t < 1f) {
+                view.postOnAnimation(this);
+            } else {
+                // Hold still briefly before lifting so the drag ends without a fling.
+                view.postDelayed(mRelease, RELEASE_HOLD_MS);
+            }
+        }
+
+        private void release() {
+            BraveContentView view = mTarget.get();
+            if (!mActive || view == null) return;
+            mActive = false;
+            long now = SystemClock.uptimeMillis();
+            dispatch(view, MotionEvent.ACTION_MOVE, mX, mLastY, mDownTime, now);
+            dispatch(view, MotionEvent.ACTION_UP, mX, mLastY, mDownTime, now);
+            if (mAnimation == this) mAnimation = null;
+        }
+
+        void cancel() {
+            BraveContentView view = mTarget.get();
+            if (!mActive) return;
+            mActive = false;
+            if (view == null) return;
+            view.removeCallbacks(this);
+            view.removeCallbacks(mRelease);
+            long now = SystemClock.uptimeMillis();
+            dispatch(view, MotionEvent.ACTION_CANCEL, mX, mLastY, mDownTime, now);
+        }
+
+        private float easeInOut(float t) {
+            return t < 0.5f ? 4 * t * t * t : 1 - (float) Math.pow(-2 * t + 2, 3) / 2;
+        }
+    }
+}
