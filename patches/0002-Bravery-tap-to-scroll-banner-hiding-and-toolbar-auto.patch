diff --git a/browser/android/bravery/bravery_banner_hider.js b/browser/android/bravery/bravery_banner_hider.js
new file mode 100644
index 000000000..e7f31db77
--- /dev/null
+++ b/browser/android/bravery/bravery_banner_hider.js
@@ -0,0 +1,299 @@
+// Copyright (c) 2026 The Bravery Authors. All rights reserved.
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this file,
+// You can obtain one at https://mozilla.org/MPL/2.0/.
+
+// Runs in Brave's internal isolated world. It shares the DOM with the page
+// but not its JavaScript globals, so `window.__bravery` is private to us and
+// survives between calls for the lifetime of the document.
+(() => {
+  // A document replaced via document.open() keeps the same window, so check
+  // which document the existing instance belongs to.
+  if (window.__bravery && window.__bravery.document === document) {
+    return
+  }
+
+  const ATTR = 'data-bravery-banner'
+  const EDGE_ATTR = 'data-bravery-edge'
+  const HIDDEN_ATTR = 'data-bravery-banners-hidden'
+  const STYLE_ID = 'bravery-banner-style'
+  // Scroll this far in one direction before banners move, like the toolbar.
+  const SCROLL_THRESHOLD = 12
+
+  const state = {
+    rules: [],
+    observer: null,
+    observedRoot: null,
+    applyScheduled: false,
+    scrollListening: false,
+    lastScroll: new WeakMap(),
+  }
+
+  function ensureStyle() {
+    if (document.getElementById(STYLE_ID)) {
+      return
+    }
+    const style = document.createElement('style')
+    style.id = STYLE_ID
+    style.textContent = `
+[${ATTR}="remove"] { display: none !important; }
+[${ATTR}="autohide"] { transition: transform 0.2s ease-out !important; }
+html[${HIDDEN_ATTR}] [${ATTR}="autohide"][${EDGE_ATTR}="top"] {
+  transform: translateY(calc(-100% - 16px)) !important;
+}
+html[${HIDDEN_ATTR}] [${ATTR}="autohide"][${EDGE_ATTR}="bottom"] {
+  transform: translateY(calc(100% + 16px)) !important;
+}`
+    ;(document.head || document.documentElement).appendChild(style)
+  }
+
+  function isPinned(el) {
+    const position = getComputedStyle(el).position
+    return position === 'fixed' || position === 'sticky'
+  }
+
+  function isRoot(el) {
+    return el === document.documentElement || el === document.body
+  }
+
+  // The outermost fixed/sticky element containing `start`, or null.
+  function bannerFor(start) {
+    let banner = null
+    for (let el = start; el && !isRoot(el); el = el.parentElement) {
+      if (el.nodeType === Node.ELEMENT_NODE && isPinned(el)) {
+        banner = el
+      }
+    }
+    return banner
+  }
+
+  function bannerAtPoint(x, y) {
+    for (const el of document.elementsFromPoint(x, y)) {
+      const banner = bannerFor(el)
+      if (banner) {
+        return banner
+      }
+    }
+    return null
+  }
+
+  // Class names that look generated (CSS-in-JS hashes etc.) change between
+  // deploys, so they make poor selectors.
+  function isStableToken(token) {
+    return (
+      token.length > 0
+      && token.length <= 40
+      && !/\d{3,}/.test(token)
+      && !/^(css|sc|jsx|emotion|styled|svelte)-/.test(token)
+      && !/^[a-zA-Z0-9_-]*[A-Z][a-zA-Z0-9_-]*[0-9][a-zA-Z0-9_-]*$/.test(token)
+    )
+  }
+
+  function isUnique(selector) {
+    try {
+      return document.querySelectorAll(selector).length === 1
+    } catch (e) {
+      return false
+    }
+  }
+
+  function selectorFor(target) {
+    if (target.id && isStableToken(target.id)) {
+      const byId = '#' + CSS.escape(target.id)
+      if (isUnique(byId)) {
+        return byId
+      }
+    }
+    const parts = []
+    for (let el = target; el && !isRoot(el) && parts.length < 6;
+         el = el.parentElement) {
+      let part = el.localName
+      const classes = Array.from(el.classList).filter(isStableToken).slice(0, 3)
+      if (classes.length) {
+        part += classes.map((c) => '.' + CSS.escape(c)).join('')
+      }
+      const parent = el.parentElement
+      if (parent) {
+        const sameTag = Array.from(parent.children)
+          .filter((c) => c.localName === el.localName)
+        if (sameTag.length > 1) {
+          part += `:nth-of-type(${sameTag.indexOf(el) + 1})`
+        }
+      }
+      parts.unshift(part)
+      const selector = parts.join(' > ')
+      if (isUnique(selector)) {
+        return selector
+      }
+    }
+    return null
+  }
+
+  function edgeFor(el) {
+    const rect = el.getBoundingClientRect()
+    return rect.top + rect.height / 2 < window.innerHeight / 2 ? 'top' : 'bottom'
+  }
+
+  function unlockScrollIfBlocked(el) {
+    // Cookie walls and sign-up modals often freeze page scrolling. If we
+    // removed a large overlay, let the page scroll again.
+    const rect = el.getBoundingClientRect()
+    const coverage = (rect.width * rect.height)
+      / (window.innerWidth * window.innerHeight)
+    if (coverage < 0.4) {
+      return
+    }
+    for (const root of [document.documentElement, document.body]) {
+      if (root && getComputedStyle(root).overflowY === 'hidden') {
+        root.style.setProperty('overflow', 'auto', 'important')
+      }
+    }
+  }
+
+  function mark(el, mode) {
+    if (el.getAttribute(ATTR) === mode) {
+      return
+    }
+    if (mode === 'remove') {
+      unlockScrollIfBlocked(el)
+    } else {
+      el.setAttribute(EDGE_ATTR, edgeFor(el))
+      listenForScroll()
+    }
+    el.setAttribute(ATTR, mode)
+  }
+
+  function onScroll(event) {
+    const target = event.target
+    const isDocument = target === document || target === document.documentElement
+      || target === document.scrollingElement
+    const key = isDocument ? document : target
+    const position = isDocument ? window.scrollY : target.scrollTop
+    if (!state.lastScroll.has(key)) {
+      state.lastScroll.set(key, isDocument ? 0 : position)
+    }
+    const delta = position - state.lastScroll.get(key)
+    if (Math.abs(delta) < SCROLL_THRESHOLD && position > 0) {
+      return
+    }
+    state.lastScroll.set(key, position)
+    const hide = position > 0 && delta > 0
+    document.documentElement.toggleAttribute(HIDDEN_ATTR, hide)
+  }
+
+  function listenForScroll() {
+    if (state.scrollListening) {
+      return
+    }
+    state.scrollListening = true
+    document.addEventListener('scroll', onScroll, { capture: true, passive: true })
+  }
+
+  function applyRulesNow() {
+    state.applyScheduled = false
+    for (const rule of state.rules) {
+      let matches
+      try {
+        matches = document.querySelectorAll(rule.s)
+      } catch (e) {
+        continue
+      }
+      for (const el of matches) {
+        mark(el, rule.m)
+      }
+    }
+  }
+
+  function scheduleApply() {
+    if (state.applyScheduled) {
+      return
+    }
+    state.applyScheduled = true
+    setTimeout(applyRulesNow, 200)
+  }
+
+  function watchForNewBanners() {
+    // document.open() keeps the document but replaces its root element.
+    const root = document.documentElement
+    if (state.observer && state.observedRoot === root) {
+      return
+    }
+    if (state.observer) {
+      state.observer.disconnect()
+    }
+    // Banners are often inserted after load, and frameworks may re-render
+    // them without our attributes.
+    state.observer = new MutationObserver(scheduleApply)
+    state.observedRoot = root
+    state.observer.observe(root, { childList: true, subtree: true })
+  }
+
+  function hide(banner, mode) {
+    if (!banner) {
+      return JSON.stringify({ ok: false })
+    }
+    ensureStyle()
+    mark(banner, mode)
+    const selector = selectorFor(banner)
+    if (selector) {
+      state.rules = state.rules.filter((r) => r.s !== selector)
+      state.rules.push({ s: selector, m: mode })
+      watchForNewBanners()
+    }
+    return JSON.stringify({ ok: true, selector, mode })
+  }
+
+  window.__bravery = {
+    document,
+
+    // `x` and `y` are physical pixels relative to the page view.
+    hideAt(x, y, mode) {
+      const viewport = window.visualViewport
+      const scale = viewport ? viewport.scale : 1
+      const cssX = x / window.devicePixelRatio / scale
+        + (viewport ? viewport.offsetLeft : 0)
+      const cssY = y / window.devicePixelRatio / scale
+        + (viewport ? viewport.offsetTop : 0)
+      return hide(bannerAtPoint(cssX, cssY), mode)
+    },
+
+    hideSelection(mode) {
+      const selection = window.getSelection()
+      if (!selection || selection.rangeCount === 0) {
+        return JSON.stringify({ ok: false })
+      }
+      let node = selection.getRangeAt(0).commonAncestorContainer
+      if (node.nodeType !== Node.ELEMENT_NODE) {
+        node = node.parentElement
+      }
+      const result = hide(node ? bannerFor(node) : null, mode)
+      selection.removeAllRanges()
+      return result
+    },
+
+    applyRules(rules) {
+      if (!Array.isArray(rules) || rules.length === 0) {
+        return ''
+      }
+      state.rules = rules.filter((r) => r && typeof r.s === 'string')
+      ensureStyle()
+      applyRulesNow()
+      watchForNewBanners()
+      return ''
+    },
+
+    reset() {
+      state.rules = []
+      if (state.observer) {
+        state.observer.disconnect()
+        state.observer = null
+      }
+      for (const el of document.querySelectorAll(`[${ATTR}]`)) {
+        el.removeAttribute(ATTR)
+        el.removeAttribute(EDGE_ATTR)
+      }
+      document.documentElement.removeAttribute(HIDDEN_ATTR)
+      return ''
+    },
+  }
+})()
