@@ -0,0 +1,92 @@
+/* Copyright (c) 2026 The Bravery Authors. All rights reserved.
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+package org.chromium.chrome.browser.bravery;
+
+import android.os.Bundle;
+
+import androidx.preference.Preference;
+
+import org.chromium.base.supplier.MonotonicObservableSupplier;
+import org.chromium.base.supplier.ObservableSuppliers;
+import org.chromium.base.supplier.SettableMonotonicObservableSupplier;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.settings.BravePreferenceFragment;
+import org.chromium.components.browser_ui.settings.SettingsUtils;
+import org.chromium.components.browser_ui.settings.search.BaseSearchIndexProvider;
+
+/** Settings > Bravery. Values are stored by the preference widgets directly in BraveryPrefs. */
+public class BraveryPreferences extends BravePreferenceFragment {
+    private static final String PREF_TAP_SCROLL_RESET_SITES = "bravery_tap_scroll_reset_sites";
+    private static final String PREF_BANNER_RESET_SITES = "bravery_banner_reset_sites";
+
+    private final SettableMonotonicObservableSupplier<String> mPageTitle =
+            ObservableSuppliers.createMonotonic();
+
+    @Override
+    public void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        // Must precede inflation so the widgets read and write Bravery's own preference file.
+        getPreferenceManager().setSharedPreferencesName(BraveryPrefs.FILE_NAME);
+        mPageTitle.set(getString(R.string.bravery_settings_title));
+        SettingsUtils.addPreferencesFromResource(this, R.xml.bravery_preferences);
+
+        Preference resetTapSites = findPreference(PREF_TAP_SCROLL_RESET_SITES);
+        if (resetTapSites != null) {
+            resetTapSites.setOnPreferenceClickListener(
+                    preference -> {
+                        BraveryPrefs.clearTapScrollDisabledSites();
+                        updateSummaries();
+                        return true;
+                    });
+        }
+        Preference resetBannerSites = findPreference(PREF_BANNER_RESET_SITES);
+        if (resetBannerSites != null) {
+            resetBannerSites.setOnPreferenceClickListener(
+                    preference -> {
+                        BraveryPrefs.clearAllBannerRules();
+                        updateSummaries();
+                        return true;
+                    });
+        }
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        updateSummaries();
+    }
+
+    @Override
+    public MonotonicObservableSupplier<String> getPageTitle() {
+        return mPageTitle;
+    }
+
+    @Override
+    public String getMainMenuKey() {
+        return "bravery";
+    }
+
+    private void updateSummaries() {
+        Preference resetTapSites = findPreference(PREF_TAP_SCROLL_RESET_SITES);
+        if (resetTapSites != null) {
+            int count = BraveryPrefs.getTapScrollDisabledSiteCount();
+            resetTapSites.setEnabled(count > 0);
+            resetTapSites.setSummary(
+                    getString(R.string.bravery_tap_scroll_reset_sites_summary, count));
+        }
+        Preference resetBannerSites = findPreference(PREF_BANNER_RESET_SITES);
+        if (resetBannerSites != null) {
+            int count = BraveryPrefs.getBannerSiteCount();
+            resetBannerSites.setEnabled(count > 0);
+            resetBannerSites.setSummary(
+                    getString(R.string.bravery_banner_reset_sites_summary, count));
+        }
+    }
+
+    public static final BaseSearchIndexProvider SEARCH_INDEX_DATA_PROVIDER =
+            new BaseSearchIndexProvider(
+                    BraveryPreferences.class.getName(), BaseSearchIndexProvider.INDEX_OPT_OUT);
+}
diff --git a/android/java/org/chromium/chrome/browser/bravery/BraveryPrefs.java b/android/java/org/chromium/chrome/browser/bravery/BraveryPrefs.java
new file mode 100644
index 000000000..549288d67
--- /dev/null
+++ b/android/java/org/chromium/chrome/browser/bravery/BraveryPrefs.java
@@ -0,0 +1,159 @@
+/* Copyright (c) 2026 The Bravery Authors. All rights reserved.
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+package org.chromium.chrome.browser.bravery;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import org.chromium.base.ContextUtils;
+
+import java.util.HashSet;
+import java.util.Set;
+
+/**
+ * Settings for Bravery's additions. Kept in a dedicated SharedPreferences file so they never
+ * collide with Brave's own keys and survive Brave updates untouched.
+ */
+public final class BraveryPrefs {
+    public static final String FILE_NAME = "bravery";
+
+    public static final String TOOLBAR_HIDE_WITH_ACCESSIBILITY = "toolbar_hide_with_accessibility";
+
+    public static final String TAP_SCROLL_ENABLED = "tap_scroll_enabled";
+    public static final String TAP_SCROLL_LAYOUT = "tap_scroll_layout";
+    public static final String TAP_SCROLL_DISTANCE = "tap_scroll_distance";
+    public static final String TAP_SCROLL_SPEED = "tap_scroll_speed";
+    public static final String TAP_SCROLL_INVERT = "tap_scroll_invert";
+    private static final String TAP_SCROLL_DISABLED_SITES = "tap_scroll_disabled_sites";
+
+    public static final String BANNER_MENU_ENABLED = "banner_menu_enabled";
+    private static final String BANNER_SITES = "banner_sites";
+    private static final String BANNER_RULES_PREFIX = "banner_rules:";
+
+    public static final String LAYOUT_EDGES = "edges";
+    public static final String LAYOUT_SIDES = "sides";
+    public static final String LAYOUT_CORNERS = "corners";
+
+    public static final String SPEED_SLOW = "slow";
+    public static final String SPEED_MEDIUM = "medium";
+    public static final String SPEED_FAST = "fast";
+
+    private BraveryPrefs() {}
+
+    public static SharedPreferences get() {
+        return ContextUtils.getApplicationContext()
+                .getSharedPreferences(FILE_NAME, Context.MODE_PRIVATE);
+    }
+
+    /**
+     * Chromium pins the toolbar whenever an accessibility service that can perform gestures is
+     * running. That is what kept the URL bar from ever hiding while Tap2Scroll was enabled.
+     */
+    public static boolean shouldHideToolbarWithAccessibility() {
+        return get().getBoolean(TOOLBAR_HIDE_WITH_ACCESSIBILITY, true);
+    }
+
+    public static boolean isTapScrollEnabled() {
+        return get().getBoolean(TAP_SCROLL_ENABLED, true);
+    }
+
+    public static String getTapScrollLayout() {
+        return get().getString(TAP_SCROLL_LAYOUT, LAYOUT_EDGES);
+    }
+
+    /** Scroll distance as a fraction of the visible page height. */
+    public static float getTapScrollDistance() {
+        int percent;
+        try {
+            percent = Integer.parseInt(get().getString(TAP_SCROLL_DISTANCE, "75"));
+        } catch (NumberFormatException e) {
+            percent = 75;
+        }
+        return Math.max(10, Math.min(100, percent)) / 100f;
+    }
+
+    public static long getTapScrollDurationMs() {
+        String speed = get().getString(TAP_SCROLL_SPEED, SPEED_MEDIUM);
+        if (SPEED_SLOW.equals(speed)) return 400;
+        if (SPEED_FAST.equals(speed)) return 150;
+        return 250;
+    }
+
+    public static boolean isTapScrollInverted() {
+        return get().getBoolean(TAP_SCROLL_INVERT, false);
+    }
+
+    public static boolean isTapScrollDisabledForSite(String host) {
+        return host != null
+                && get().getStringSet(TAP_SCROLL_DISABLED_SITES, new HashSet<>()).contains(host);
+    }
+
+    public static void setTapScrollDisabledForSite(String host, boolean disabled) {
+        if (host == null || host.isEmpty()) return;
+        Set<String> sites =
+                new HashSet<>(get().getStringSet(TAP_SCROLL_DISABLED_SITES, new HashSet<>()));
+        if (disabled) {
+            sites.add(host);
+        } else {
+            sites.remove(host);
+        }
+        get().edit().putStringSet(TAP_SCROLL_DISABLED_SITES, sites).apply();
+    }
+
+    public static int getTapScrollDisabledSiteCount() {
+        return get().getStringSet(TAP_SCROLL_DISABLED_SITES, new HashSet<>()).size();
+    }
+
+    public static void clearTapScrollDisabledSites() {
+        get().edit().remove(TAP_SCROLL_DISABLED_SITES).apply();
+    }
+
+    public static boolean isBannerMenuEnabled() {
+        return get().getBoolean(BANNER_MENU_ENABLED, true);
+    }
+
+    /** Banner rules for a site, as a JSON array of {"s": selector, "m": mode}. */
+    public static String getBannerRules(String host) {
+        if (host == null || host.isEmpty()) return "[]";
+        return get().getString(BANNER_RULES_PREFIX + host, "[]");
+    }
+
+    public static boolean hasBannerRules(String host) {
+        return host != null && get().contains(BANNER_RULES_PREFIX + host);
+    }
+
+    public static void setBannerRules(String host, String rulesJson) {
+        if (host == null || host.isEmpty()) return;
+        Set<String> sites = new HashSet<>(get().getStringSet(BANNER_SITES, new HashSet<>()));
+        sites.add(host);
+        get().edit()
+                .putString(BANNER_RULES_PREFIX + host, rulesJson)
+                .putStringSet(BANNER_SITES, sites)
+                .apply();
+    }
+
+    public static void clearBannerRules(String host) {
+        if (host == null || host.isEmpty()) return;
+        Set<String> sites = new HashSet<>(get().getStringSet(BANNER_SITES, new HashSet<>()));
+        sites.remove(host);
+        get().edit()
+                .remove(BANNER_RULES_PREFIX + host)
+                .putStringSet(BANNER_SITES, sites)
+                .apply();
+    }
+
+    public static int getBannerSiteCount() {
+        return get().getStringSet(BANNER_SITES, new HashSet<>()).size();
+    }
+
+    public static void clearAllBannerRules() {
+        SharedPreferences.Editor editor = get().edit();
+        for (String host : get().getStringSet(BANNER_SITES, new HashSet<>())) {
+            editor.remove(BANNER_RULES_PREFIX + host);
+        }
+        editor.remove(BANNER_SITES).apply();
+    }
+}
