diff --git a/android/java/org/chromium/chrome/browser/bravery/BraveryBannerHider.java b/android/java/org/chromium/chrome/browser/bravery/BraveryBannerHider.java
new file mode 100644
index 000000000..cde231a43
--- /dev/null
+++ b/android/java/org/chromium/chrome/browser/bravery/BraveryBannerHider.java
@@ -0,0 +1,147 @@
+/* Copyright (c) 2026 The Bravery Authors. All rights reserved.
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+package org.chromium.chrome.browser.bravery;
+
+import android.content.Context;
+
+import org.jni_zero.JNINamespace;
+import org.jni_zero.NativeMethods;
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import org.chromium.base.Callback;
+import org.chromium.base.ContextUtils;
+import org.chromium.chrome.R;
+import org.chromium.content_public.browser.WebContents;
+import org.chromium.ui.widget.Toast;
+
+/**
+ * Hides fixed and sticky page banners (cookie notices, "open in app" bars, sticky headers) that
+ * the user long-presses. The page-side logic lives in bravery_banner_hider.js, which runs in
+ * Brave's internal isolated world so pages can neither see nor tamper with it.
+ *
+ * <p>Two modes: "autohide" slides the banner out of the way while scrolling down and brings it
+ * back when scrolling up, like the URL bar; "remove" hides it outright. Choices are remembered
+ * per site (except in private tabs) and re-applied whenever the site loads.
+ */
+@JNINamespace("bravery")
+public final class BraveryBannerHider {
+    public static final String MODE_AUTOHIDE = "autohide";
+    public static final String MODE_REMOVE = "remove";
+
+    private BraveryBannerHider() {}
+
+    /** Hides the banner under a point given in DIPs relative to the page view. */
+    public static void hideAt(WebContents webContents, float xDip, float yDip, String mode) {
+        float density =
+                ContextUtils.getApplicationContext().getResources().getDisplayMetrics().density;
+        run(
+                webContents,
+                "hideAt("
+                        + xDip * density
+                        + ","
+                        + yDip * density
+                        + ","
+                        + JSONObject.quote(mode)
+                        + ")",
+                result -> onHideResult(webContents, result));
+    }
+
+    /** Hides the banner containing the current text selection. */
+    public static void hideSelection(WebContents webContents, String mode) {
+        run(
+                webContents,
+                "hideSelection(" + JSONObject.quote(mode) + ")",
+                result -> onHideResult(webContents, result));
+    }
+
+    /** Re-applies remembered rules for the page's site. Safe to call repeatedly. */
+    public static void applySavedRules(WebContents webContents) {
+        if (webContents == null || webContents.isDestroyed()) return;
+        String host = webContents.getLastCommittedUrl().getHost();
+        if (!BraveryPrefs.hasBannerRules(host)) return;
+        run(webContents, "applyRules(" + BraveryPrefs.getBannerRules(host) + ")", null);
+    }
+
+    public static boolean hasSavedRules(WebContents webContents) {
+        return webContents != null
+                && !webContents.isDestroyed()
+                && BraveryPrefs.hasBannerRules(webContents.getLastCommittedUrl().getHost());
+    }
+
+    /** Forgets every banner hidden on the page's site and shows them again. */
+    public static void restoreSite(WebContents webContents) {
+        if (webContents == null || webContents.isDestroyed()) return;
+        BraveryPrefs.clearBannerRules(webContents.getLastCommittedUrl().getHost());
+        run(webContents, "reset()", null);
+        showToast(R.string.bravery_banner_restored);
+    }
+
+    private static void run(WebContents webContents, String call, Callback<String> callback) {
+        if (webContents == null || webContents.isDestroyed()) return;
+        BraveryBannerHiderJni.get()
+                .runScript(
+                        webContents,
+                        "window.__bravery." + call,
+                        callback != null ? callback : result -> {});
+    }
+
+    private static void onHideResult(WebContents webContents, String result) {
+        JSONObject json;
+        try {
+            json = new JSONObject(result);
+        } catch (JSONException e) {
+            json = new JSONObject();
+        }
+        if (!json.optBoolean("ok")) {
+            showToast(R.string.bravery_banner_not_found);
+            return;
+        }
+        String selector = json.optString("selector", "");
+        String mode = json.optString("mode", MODE_AUTOHIDE);
+        if (!selector.isEmpty()
+                && webContents != null
+                && !webContents.isDestroyed()
+                && !webContents.isIncognito()) {
+            remember(webContents.getLastCommittedUrl().getHost(), selector, mode);
+        }
+        showToast(
+                MODE_REMOVE.equals(mode)
+                        ? R.string.bravery_banner_removed
+                        : R.string.bravery_banner_autohidden);
+    }
+
+    private static void remember(String host, String selector, String mode) {
+        JSONArray rules;
+        try {
+            rules = new JSONArray(BraveryPrefs.getBannerRules(host));
+        } catch (JSONException e) {
+            rules = new JSONArray();
+        }
+        JSONArray updated = new JSONArray();
+        for (int i = 0; i < rules.length(); i++) {
+            JSONObject rule = rules.optJSONObject(i);
+            if (rule != null && !selector.equals(rule.optString("s"))) updated.put(rule);
+        }
+        try {
+            updated.put(new JSONObject().put("s", selector).put("m", mode));
+        } catch (JSONException e) {
+            return;
+        }
+        BraveryPrefs.setBannerRules(host, updated.toString());
+    }
+
+    private static void showToast(int messageId) {
+        Context context = ContextUtils.getApplicationContext();
+        Toast.makeText(context, context.getString(messageId), Toast.LENGTH_SHORT).show();
+    }
+
+    @NativeMethods
+    interface Natives {
+        void runScript(WebContents webContents, String script, Callback<String> callback);
+    }
+}
