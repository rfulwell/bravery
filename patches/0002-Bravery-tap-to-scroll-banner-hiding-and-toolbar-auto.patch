+
+#include <string>
+#include <utility>
+
+#include "base/android/callback_android.h"
+#include "base/android/jni_android.h"
+#include "base/android/jni_string.h"
+#include "base/functional/bind.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/values.h"
+#include "brave/browser/android/bravery/bravery_banner_hider_script.h"
+#include "chrome/android/chrome_jni_headers/BraveryBannerHider_jni.h"
+#include "chrome/common/chrome_isolated_world_ids.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+
+namespace bravery {
+
+namespace {
+
+void OnScriptResult(base::android::ScopedJavaGlobalRef<jobject> callback,
+                    base::Value result) {
+  base::android::RunStringCallbackAndroid(
+      callback, result.is_string() ? result.GetString() : std::string());
+}
+
+}  // namespace
+
+// Runs `script` in the main frame's Brave-internal isolated world, defining
+// the banner hider first if this document has not seen it yet.
+static void JNI_BraveryBannerHider_RunScript(
+    JNIEnv* env,
+    const base::android::JavaRef<jobject>& jweb_contents,
+    const base::android::JavaRef<jstring>& jscript,
+    const base::android::JavaRef<jobject>& jcallback) {
+  base::android::ScopedJavaGlobalRef<jobject> callback(jcallback);
+  content::WebContents* web_contents =
+      content::WebContents::FromJavaWebContents(jweb_contents);
+  content::RenderFrameHost* rfh =
+      web_contents ? web_contents->GetPrimaryMainFrame() : nullptr;
+  if (!rfh || !rfh->IsRenderFrameLive()) {
+    base::android::RunStringCallbackAndroid(callback, std::string());
+    return;
+  }
+
+  std::u16string script(kBraveryBannerHiderScript);
+  script += u";\n";
+  script += base::UTF8ToUTF16(base::android::ConvertJavaStringToUTF8(env, jscript));
+
+  rfh->ExecuteJavaScriptInIsolatedWorld(
+      script, base::BindOnce(&OnScriptResult, std::move(callback)),
+      ISOLATED_WORLD_ID_BRAVE_INTERNAL);
+}
+
+}  // namespace bravery
+
+DEFINE_JNI(BraveryBannerHider)
