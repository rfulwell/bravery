@@ -0,0 +1,28 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 The Bravery Authors. All rights reserved.
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this file,
+# You can obtain one at https://mozilla.org/MPL/2.0/.
+"""Wraps a JavaScript file into a C++ header as a UTF-16 raw string."""
+
+import sys
+
+DELIMITER = 'js'
+
+
+def main(source_path, header_path, variable):
+    with open(source_path, encoding='utf-8') as f:
+        script = f.read()
+    if ')' + DELIMITER + '"' in script:
+        raise ValueError(f'{source_path} contains the raw string terminator')
+    guard = 'BRAVERY_' + variable.upper() + '_H_'
+    with open(header_path, 'w', encoding='utf-8') as f:
+        f.write(f'// Generated from {source_path}. Do not edit.\n')
+        f.write(f'#ifndef {guard}\n#define {guard}\n\n')
+        f.write(f'inline constexpr char16_t {variable}[] = uR"{DELIMITER}(')
+        f.write(script)
+        f.write(f'){DELIMITER}";\n\n#endif  // {guard}\n')
+
+
+if __name__ == '__main__':
+    main(*sys.argv[1:])
