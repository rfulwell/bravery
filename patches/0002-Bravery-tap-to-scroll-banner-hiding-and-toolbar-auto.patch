+# Copyright (c) 2026 The Bravery Authors. All rights reserved.
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this file,
+# You can obtain one at https://mozilla.org/MPL/2.0/.
+
+substitutions:
+  - description: |
+      Bravery: report taps the page reacted to as handled
+
+      Tap-to-scroll only scrolls on taps the page ignored, using the
+      "consumed" bit content reports for each GestureTap. Links and form
+      submits already count as handled, but a click on a plain button or a
+      script-driven widget does not. Treat a tap as handled when click
+      dispatch changed the DOM or styles, or when it landed inside a
+      focusable element or ARIA widget (the same signals Contextual Search
+      uses to tell "did the page respond?").
+    regex:
+      re_pattern: '(\n(\s*)ShowUnhandledTapUIIfNeeded\(dom_tree_changed, style_changed, tapped_node,\s*tapped_position_in_viewport\);\n)'
+      replace: |
+        \1#if BUILDFLAG(ENABLE_UNHANDLED_TAP)
+        \2if (dom_tree_changed || style_changed ||
+        \2    WebNode(tapped_node).IsInsideFocusableElementOrARIAWidget()) {
+        \2  event_result = WebInputEventResult::kHandledSystem;
+        \2}
+        #endif  // BUILDFLAG(ENABLE_UNHANDLED_TAP)
