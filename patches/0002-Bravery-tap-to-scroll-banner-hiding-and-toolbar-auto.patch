+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+package org.chromium.chrome.browser.bravery;
+
+import android.view.MotionEvent;
+
+import org.chromium.components.embedder_support.view.BraveContentView;
+import org.chromium.content_public.browser.GestureListenerManager;
+import org.chromium.content_public.browser.WebContents;
+import org.chromium.content_public.browser.WebContentsObserver;
+import org.chromium.url.GURL;
+
+import java.util.Map;
+import java.util.HashMap;
+
+/** Attaches Bravery's per-tab features to every page view. Installed once per process. */
+public final class BraveryController implements BraveContentView.BraveryHook {
+    private static BraveryController sInstance;
+
+    private final Map<WebContents, TabState> mTabStates = new HashMap<>();
+
+    private BraveryController() {}
+
+    public static void install() {
+        if (sInstance != null) return;
+        sInstance = new BraveryController();
+        BraveContentView.setBraveryHook(sInstance);
+    }
+
+    @Override
+    public void onWebContentsAttached(BraveContentView view, WebContents webContents) {
+        getOrCreateState(webContents).tapToScroll.setView(view);
+    }
+
+    @Override
+    public void onTouchEvent(BraveContentView view, MotionEvent event) {
+        WebContents webContents = view.getWebContents();
+        if (webContents == null || webContents.isDestroyed()) return;
+        TabState state = getOrCreateState(webContents);
+        if (event.getActionMasked() == MotionEvent.ACTION_DOWN) {
+            // Chrome may install its own selection menu delegate after the view is created.
+            BraverySelectionMenuDelegate.ensureInstalled(webContents);
+        }
+        state.tapToScroll.onTouchEvent(view, event);
+    }
+
+    private TabState getOrCreateState(WebContents webContents) {
+        TabState state = mTabStates.get(webContents);
+        if (state == null) {
+            state = new TabState(webContents);
+            mTabStates.put(webContents, state);
+        }
+        return state;
+    }
+
+    private final class TabState extends WebContentsObserver {
+        final BraveryTapToScroll tapToScroll;
+
+        TabState(WebContents webContents) {
+            super(webContents);
+            tapToScroll = new BraveryTapToScroll(webContents);
+            GestureListenerManager gestures = GestureListenerManager.fromWebContents(webContents);
+            if (gestures != null) gestures.addListener(tapToScroll);
+            BraverySelectionMenuDelegate.ensureInstalled(webContents);
+        }
+
+        @Override
+        public void primaryMainDocumentElementAvailable() {
+            applyBannerRules();
+        }
+
+        @Override
+        public void didStopLoading(GURL url, boolean isKnownValid) {
+            applyBannerRules();
+        }
+
+        @Override
+        public void webContentsDestroyed() {
+            WebContents webContents = getWebContents();
+            if (webContents != null) mTabStates.remove(webContents);
+            observe(null);
+        }
+
+        private void applyBannerRules() {
+            WebContents webContents = getWebContents();
+            if (webContents != null) BraveryBannerHider.applySavedRules(webContents);
+        }
+    }
+}
diff --git a/android/java/org/chromium/chrome/browser/bravery/BraveryPreferences.java b/android/java/org/chromium/chrome/browser/bravery/BraveryPreferences.java
