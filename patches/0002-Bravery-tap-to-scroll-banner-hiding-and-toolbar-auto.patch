 /** That class extends upstream's ContentView.java to prevent a browser process crash */
 public class BraveContentView extends ContentView {
+    /**
+     * Bravery: lets the chrome layer observe page touches and WebContents changes without this
+     * component depending on it. Installed once at startup by BraveryController.
+     */
+    public interface BraveryHook {
+        void onWebContentsAttached(BraveContentView view, WebContents webContents);
+
+        void onTouchEvent(BraveContentView view, MotionEvent event);
+    }
+
+    private static BraveryHook sBraveryHook;
+
+    public static void setBraveryHook(BraveryHook hook) {
+        sBraveryHook = hook;
+    }
+
     protected BraveContentView(Context context, WebContents webContents) {
         super(context, webContents);
+        notifyWebContentsAttached(webContents);
+    }
+
+    @Override
+    public void setWebContents(WebContents webContents) {
+        super.setWebContents(webContents);
+        notifyWebContentsAttached(webContents);
+    }
+
+    @Override
+    public boolean onTouchEvent(MotionEvent event) {
+        if (sBraveryHook != null) sBraveryHook.onTouchEvent(this, event);
+        return super.onTouchEvent(event);
+    }
+
+    private void notifyWebContentsAttached(WebContents webContents) {
+        if (sBraveryHook != null && webContents != null) {
+            sBraveryHook.onWebContentsAttached(this, webContents);
