+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+package org.chromium.chrome.browser.bravery;
+
+import static org.chromium.ui.listmenu.ListMenuItemProperties.ENABLED;
+import static org.chromium.ui.listmenu.ListMenuItemProperties.MENU_ITEM_ID;
+import static org.chromium.ui.listmenu.ListMenuItemProperties.TEXT_APPEARANCE_ID;
+import static org.chromium.ui.listmenu.ListMenuItemProperties.TITLE;
+
+import android.content.Context;
+
+import org.chromium.chrome.R;
+import org.chromium.components.browser_ui.widget.BrowserUiListMenuUtils;
+import org.chromium.components.embedder_support.contextmenu.ContextMenuParams;
+import org.chromium.content_public.browser.WebContents;
+import org.chromium.ui.listmenu.ListItemType;
+import org.chromium.ui.listmenu.ListMenuItemProperties;
+import org.chromium.ui.modelutil.MVCListAdapter.ListItem;
+import org.chromium.ui.modelutil.MVCListAdapter.ModelList;
+import org.chromium.ui.modelutil.PropertyModel;
+
+import java.util.List;
+
+/**
+ * Bravery's group in the long-press menu. Chromium already sends a menu request when an empty
+ * part of the page is long-pressed but normally has nothing to show; adding this group makes the
+ * menu appear there too, so any part of a banner can be long-pressed.
+ */
+public final class BraveryContextMenu {
+    private BraveryContextMenu() {}
+
+    public static void addItems(
+            Context context, List<ModelList> groups, WebContents webContents) {
+        if (webContents == null || webContents.isDestroyed()) return;
+        ModelList group = new ModelList();
+        if (BraveryPrefs.isBannerMenuEnabled()) {
+            group.add(item(context, R.id.bravery_banner_autohide, R.string.bravery_banner_autohide));
+            group.add(item(context, R.id.bravery_banner_remove, R.string.bravery_banner_remove));
+            if (BraveryBannerHider.hasSavedRules(webContents)) {
+                group.add(
+                        item(context, R.id.bravery_banner_restore, R.string.bravery_banner_restore));
+            }
+        }
+        if (BraveryPrefs.isTapScrollEnabled()) {
+            boolean disabledHere =
+                    BraveryPrefs.isTapScrollDisabledForSite(
+                            webContents.getLastCommittedUrl().getHost());
+            group.add(
+                    item(
+                            context,
+                            R.id.bravery_tap_scroll_site,
+                            disabledHere
+                                    ? R.string.bravery_tap_scroll_enable_site
+                                    : R.string.bravery_tap_scroll_disable_site));
+        }
+        if (!group.isEmpty()) groups.add(group);
+    }
+
+    /** Returns true if the item was one of Bravery's. */
+    public static boolean onItemSelected(
+            int itemId, ContextMenuParams params, WebContents webContents) {
+        if (itemId == R.id.bravery_banner_autohide || itemId == R.id.bravery_banner_remove) {
+            BraveryBannerHider.hideAt(
+                    webContents,
+                    params.getTriggeringTouchXDp(),
+                    params.getTriggeringTouchYDp(),
+                    itemId == R.id.bravery_banner_remove
+                            ? BraveryBannerHider.MODE_REMOVE
+                            : BraveryBannerHider.MODE_AUTOHIDE);
+            return true;
+        }
+        if (itemId == R.id.bravery_banner_restore) {
+            BraveryBannerHider.restoreSite(webContents);
+            return true;
+        }
+        if (itemId == R.id.bravery_tap_scroll_site) {
+            if (webContents != null && !webContents.isDestroyed()) {
+                String host = webContents.getLastCommittedUrl().getHost();
+                BraveryPrefs.setTapScrollDisabledForSite(
+                        host, !BraveryPrefs.isTapScrollDisabledForSite(host));
+            }
+            return true;
+        }
+        return false;
+    }
+
+    private static ListItem item(Context context, int id, int titleRes) {
+        PropertyModel model =
+                new PropertyModel.Builder(ListMenuItemProperties.ALL_KEYS)
+                        .with(MENU_ITEM_ID, id)
+                        .with(TITLE, context.getString(titleRes))
+                        .with(ENABLED, true)
+                        .with(
+                                TEXT_APPEARANCE_ID,
+                                BrowserUiListMenuUtils.getDefaultTextAppearanceStyle())
+                        .build();
+        return new ListItem(ListItemType.MENU_ITEM, model);
+    }
+}
